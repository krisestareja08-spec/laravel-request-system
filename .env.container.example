# Copy this file to .env.container and replace the placeholder values.
# .env.container is ignored by Git and .dockerignore, so it never goes
# into GitHub or into the Docker images. Compose passes it at runtime.

APP_NAME="Laravel Request System"
APP_ENV=local
APP_DEBUG=false
# generate once and keep it the same (see README)
APP_KEY=
APP_URL=http://127.0.0.1:8080

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=laravel_request_container_db
DB_USERNAME=request_app
DB_PASSWORD=change_me

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# Used by the MySQL container the first time the db_data volume is created.
# These must match the DB_ values above.
MYSQL_DATABASE=laravel_request_container_db
MYSQL_USER=request_app
MYSQL_PASSWORD=change_me
# root is not used by the app, so MySQL generates a random root password
MYSQL_RANDOM_ROOT_PASSWORD=yes
